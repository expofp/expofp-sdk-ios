able","}",".store(in: &cancellables)","","let controller = presenter.getViewController()"],"type":"codeListing"},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Publisher does not replay past errors. An error reported while presenting the plan can be missed if the subscription is created later."}],"type":"paragraph"}],"style":"important"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpError\/planDidTerminate"},{"type":"text","text":" received here is the only signal that a "},{"code":"ready","type":"codeVoice"},{"type":"text","text":" plan has stopped working – "},{"isActive":true,"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","type":"reference"},{"type":"text","text":" keeps the "},{"type":"codeVoice","code":"ready"},{"type":"text","text":" status. Reload the plan to recover from it:"}]}]},{"syntax":"swift","code":["\/\/ 'presenter' owns the publisher, so capture it weakly – a strong capture here","\/\/ keeps the presenter and its WKWebView alive for the lifetime of the app.","presenter.planOperationalErrorPublisher.sink { [weak presenter] error in","    if case .planDidTerminate = error {","        presenter?.reloadPlan()","    }","}",".store(in: &cancellables)"],"type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Manage-properties-and-settings"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Load-Plan","doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Download-Plan","doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Preload-Plan","doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Manage-Plan","doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Listen-Plan-events","doc:\/\/com.exp