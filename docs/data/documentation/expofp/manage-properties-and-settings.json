lay(false)]","","presenter.removeAdditionalParams(forKeys: [ExpoFpPlanParameter.noOverlay(false).key])","presenter.additionalParams \/\/ []"],"type":"codeListing"},{"inlineContent":[{"text":"Add, change or remove location provider:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["presenter.locationProvider \/\/ SomeLocationProvider or nil","","let locationProvider = YourLocationProvider()","presenter.setLocationProvider(locationProvider)","","presenter.locationProvider \/\/ YourLocationProvider","","presenter.removeLocationProvider()","","presenter.locationProvider \/\/ nil"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add or change plan message listener:"}]},{"type":"codeListing","syntax":"swift","code":["let messageListener = YourPlanMessageListener()","presenter.setMessageListener(messageListener)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove plan message listener:"}]},{"type":"codeListing","syntax":"swift","code":["presenter.removeMessageListener()"]},{"inlineContent":[{"type":"text","text":"Add or remove custom message handler for specific callback on a plan:"}],"type":"paragraph"},{"code":["presenter.setMessageHandler(yourHandler, for: \"callbackName\")","presenter.removeMessageHandler(for: \"callbackName\")"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Check-the-plan-status","type":"heading","text":"Check the plan status"},{"inlineContent":[{"type":"text","text":"Subscribe to "},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","isActive":true},{"type":"text","text":" to follow the plan loading lifecycle – loading progress, initialization, readiness and loading failures:"}],"type":"paragraph"},{"syntax":"swift","code":["presenter.planStatusPublisher.sink { status in","    \/\/ for example hide your loading overlay when 'status.isReady'","}",".store(in: &cancellables)"],"type":"codeListing"},{"st