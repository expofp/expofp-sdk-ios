{"abstract":[{"type":"text","text":"Embed a floor plan preview in your content screens and expand it into a full interactive map on tap."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Mini-map"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A mini-map is a floor plan preview embedded directly in your app — right where attendees are already looking. Tap an exhibitor and see exactly where their booth is. Tap again to expand into a full interactive map with wayfinding directions."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"https:\/\/www.youtube.com\/watch?v=4lCnvIRL22I","isActive":true}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example follows a three-screen flow:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exhibitors List"}],"type":"strong"},{"type":"text","text":" — loads exhibitors from the SDK and renders them as a scrollable list."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Exhibitor Detail"}]},{"type":"text","text":" — shows an inline floor plan preview with the selected booth highlighted, plus Expand and Directions buttons."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fullscreen Plan"}]},{"type":"text","text":" — the mini-map expands into a full interactive plan with Collapse and Directions controls."}]}]}]},{"inlineContent":[{"type":"image","identifier":"mini-map-wireframe.svg"}],"type":"paragraph"},{"text":"Quick Start","level":2,"type":"heading","anchor":"Quick-Start"},{"inlineContent":[{"text":"The full source is in the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/expofp\/expofp-sdk-ios-examples","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["git clone https:\/\/github.com\/expofp\/expofp-sdk-ios-examples.git","cd expofp-sdk-ios-examples\/MiniMap","open MiniMap.xcodeproj"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Build and run on a simulator or device (Xcode 16+, iOS 17+).","type":"text"}],"type":"paragraph"},{"text":"Architecture","level":2,"type":"heading","anchor":"Architecture"},{"inlineContent":[{"text":"The pattern uses ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"two independent"}]},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan","isActive":true},{"text":" presenter instances created once and kept alive for the lifetime of the screen:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"miniMap"},{"type":"text","text":" — powers the inline thumbnail. Touch input is disabled so it acts as a static preview."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"map"},{"type":"text","text":" — powers the fullscreen interactive view."}]}]}]},{"inlineContent":[{"text":"Both load the same expo key but operate entirely independently. SwiftUI’s ","type":"text"},{"code":"matchedGeometryEffect","type":"codeVoice"},{"text":" animates the frame from the inline position to fullscreen.","type":"text"}],"type":"paragraph"},{"code":["@MainActor","final class ContentStore: ObservableObject {","    let miniMap = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","    let map = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","}"],"syntax":"swift","type":"codeListing"},{"text":"Plan ready → load exhibitors","level":2,"type":"heading","anchor":"Plan-ready-%E2%86%92-load-exhibitors"},{"inlineContent":[{"text":"Observe ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","isActive":true},{"text":" on the mini-map presenter. When it first reaches ","type":"text"},{"code":".ready","type":"codeVoice"},{"text":", strip the default SDK controls from both presenters and fetch the exhibitor list.","type":"text"}],"type":"paragraph"},{"code":[".onReceive(store.miniMap.planStatusPublisher) { status in","    self.status = status","","    if status == .ready && exhibitors.isEmpty {","        let visibility = ExpoFpElementsVisibility(","            controls: false,","            levels: false,","            header: false,","            overlay: false","        )","        store.miniMap.setElementsVisibility(visibility)","        store.map.setElementsVisibility(visibility)","","        Task {","            exhibitors = try await store.miniMap.exhibitorsList().get()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Embed the mini-map and handle interactions","level":2,"type":"heading","anchor":"Embed-the-mini-map-and-handle-interactions"},{"inlineContent":[{"text":"Place the mini-map view inline, disable hit-testing, and attach ","type":"text"},{"code":"matchedGeometryEffect","type":"codeVoice"},{"text":". When the detail view appears, highlight the booth on both presenters so the correct booth is highlighted whether you are looking at the thumbnail or the fullscreen map.","type":"text"}],"type":"paragraph"},{"code":["store.miniMap.getView()","    .frame(height: 200)","    .allowsHitTesting(false)","    .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: !showPlan)","    .onAppear {","        store.miniMap.selectExhibitor(nameOrExternalId: exhibitor.externalId)","        store.map.selectExhibitor(nameOrExternalId: exhibitor.externalId)","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Expand"}]},{"text":" button animates to fullscreen; the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Directions"}]},{"text":" button both expands and draws a wayfinding route:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Expand","Button {","    withAnimation(.easeInOut) { showPlan = true }","} label: {","    Image(systemName: \"arrow.up.left.and.arrow.down.right\")","}","","\/\/ Directions","Button {","    withAnimation(.easeInOut) {","        showPlan = true","        store.map.selectRoute(from: .booth(\"Entrance\"), to: .booth(exhibitor.externalId))","    }","} label: {","    HStack(spacing: 4) {","        Image(.directions)","        Text(\"Directions\").foregroundStyle(.black)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Show the fullscreen plan","level":2,"type":"heading","anchor":"Show-the-fullscreen-plan"},{"inlineContent":[{"text":"Overlay the fullscreen presenter view and mirror the ","type":"text"},{"code":"matchedGeometryEffect","type":"codeVoice"},{"text":" identifier so SwiftUI connects the two frames. The Collapse button calls ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/fitBounds(bounds:options:)","isActive":true},{"text":" to reset the zoom before animating back.","type":"text"}],"type":"paragraph"},{"code":["if showPlan {","    store.map.getView()","        .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: showPlan)","        .ignoresSafeArea()","        .overlay(alignment: .topLeading) {","            Button {","                withAnimation(.easeInOut) {","                    showPlan = false","                    store.map.fitBounds(bounds: nil, options: nil)","                }","            } label: {","                Image(systemName: \"arrow.down.right.and.arrow.up.left\")","                    .padding()","                    .background(.thinMaterial, in: Circle())","            }","            .padding()","        }","}"],"syntax":"swift","type":"codeListing"},{"text":"SDK APIs Used","level":2,"type":"heading","anchor":"SDK-APIs-Used"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan\/createPlanPresenter(with:additionalParams:locationProvider:messageListener:isDebugModeEnabled:)","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a presenter bound to an expo key"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Publisher that emits plan loading status changes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/setElementsVisibility(_:)","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide\/show default SDK UI controls"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/exhibitorsList()","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch the list of exhibitors for the plan"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/getView()","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the SwiftUI view for the presenter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanP