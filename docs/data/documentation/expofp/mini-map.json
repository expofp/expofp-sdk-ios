{"metadata":{"modules":[{"name":"ExpoFP"}],"role":"article","roleHeading":"Article","title":"Mini-Map"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Embed a floor plan preview in your content screens and expand it into a full interactive map on tap.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"A mini-map is a floor plan preview embedded directly in your app — right where attendees are already looking. Tap an exhibitor and see exactly where their booth is. Tap again to expand into a full interactive map with wayfinding directions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/www.youtube.com\/watch?v=4lCnvIRL22I"}],"type":"paragraph"},{"inlineContent":[{"text":"The example follows a three-screen flow:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exhibitors List"}],"type":"strong"},{"type":"text","text":" — loads exhibitors from the SDK and renders them as a scrollable list."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exhibitor Detail"}],"type":"strong"},{"type":"text","text":" — shows an inline floor plan preview with the selected booth highlighted, plus Expand and Directions buttons."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Fullscreen Plan"}],"type":"strong"},{"type":"text","text":" — the mini-map expands into a full interactive plan with Collapse and Directions controls."}]}]}]},{"inlineContent":[{"type":"image","identifier":"mini-map-wireframe.svg"}],"type":"paragraph"},{"text":"Quick Start","type":"heading","level":2,"anchor":"Quick-Start"},{"inlineContent":[{"text":"The full source is in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/expofp\/expofp-sdk-ios-examples"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["git clone https:\/\/github.com\/expofp\/expofp-sdk-ios-examples.git","cd expofp-sdk-ios-examples\/MiniMap","open MiniMap.xcodeproj"],"syntax":null},{"inlineContent":[{"text":"Build and run on a simulator or device (Xcode 16+, iOS 17+).","type":"text"}],"type":"paragraph"},{"text":"Architecture","type":"heading","level":2,"anchor":"Architecture"},{"inlineContent":[{"text":"The pattern uses ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"two independent"}]},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan"},{"type":"text","text":" presenter instances created once and kept alive for the lifetime of the screen:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"miniMap"},{"type":"text","text":" — powers the inline thumbnail. Touch input is disabled so it acts as a static preview."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"map"},{"type":"text","text":" — powers the fullscreen interactive view."}]}]}]},{"inlineContent":[{"type":"text","text":"Both load the same expo key but operate entirely independently. SwiftUI’s "},{"type":"codeVoice","code":"matchedGeometryEffect"},{"type":"text","text":" animates the frame from the inline position to fullscreen."}],"type":"paragraph"},{"type":"codeListing","code":["@MainActor","final class ContentStore: ObservableObject {","    let miniMap = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","    let map = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","}"],"syntax":"swift"},{"text":"Plan ready → load exhibitors","type":"heading","level":2,"anchor":"Plan-ready-%E2%86%92-load-exhibitors"},{"inlineContent":[{"type":"text","text":"Observe "},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","isActive":true},{"type":"text","text":" on the mini-map presenter. When it first reaches "},{"type":"codeVoice","code":".ready"},{"type":"text","text":", strip the default SDK controls from both presenters and fetch the exhibitor list."}],"type":"paragraph"},{"type":"codeListing","code":[".onReceive(store.miniMap.planStatusPublisher) { status in","    self.status = status","","    if status == .ready && exhibitors.isEmpty {","        let visibility = ExpoFpElementsVisibility(","            controls: false,","            levels: false,","            header: false,","            overlay: false","        )","        store.miniMap.setElementsVisibility(visibility)","        store.map.setElementsVisibility(visibility)","","        Task {","            exhibitors = try await store.miniMap.exhibitorsList().get()","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Embed the mini-map and handle interactions","anchor":"Embed-the-mini-map-and-handle-interactions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Place the mini-map view inline, disable hit-testing, and attach "},{"type":"codeVoice","code":"matchedGeometryEffect"},{"type":"text","text":". When the detail view appears, highlight the booth on both presenters so the correct booth is highlighted whether you are looking at the thumbnail or the fullscreen map."}]},{"type":"codeListing","code":["store.miniMap.getView()","    .frame(height: 200)","    .allowsHitTesting(false)","    .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: !showPlan)","    .onAppear {","        store.miniMap.selectExhibitor(nameOrExternalId: exhibitor.externalId)","        store.map.selectExhibitor(nameOrExternalId: exhibitor.externalId)","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"text":"Expand","type":"text"}],"type":"strong"},{"text":" button animates to fullscreen; the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Directions"}]},{"text":" button both expands and draws a wayfinding route:","type":"text"}]},{"type":"codeListing","code":["\/\/ Expand","Button {","    withAnimation(.easeInOut) { showPlan = true }","} label: {","    Image(systemName: \"arrow.up.left.and.arrow.down.right\")","}","","\/\/ Directions","Button {","    withAnimation(.easeInOut) {","        showPlan = true","        store.map.selectRoute(from: .booth(\"Entrance\"), to: .booth(exhibitor.externalId))","    }","} label: {","    HStack(spacing: 4) {","        Image(.directions)","        Text(\"Directions\").foregroundStyle(.black)","    }","}"],"syntax":"swift"},{"type":"heading","text":"Show the fullscreen plan","anchor":"Show-the-fullscreen-plan","level":2},{"type":"paragraph","inlineContent":[{"text":"Overlay the fullscreen presenter view and mirror the ","type":"text"},{"type":"codeVoice","code":"matchedGeometryEffect"},{"text":" identifier so SwiftUI connects the two frames. The Collapse button calls ","type":"text"},{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/fitBounds(bounds:options:)","type":"reference","isActive":true},{"text":" to reset the zoom before animating back.","type":"text"}]},{"type":"codeListing","code":["if showPlan {","    store.map.getView()","        .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: showPlan)","        .ignoresSafeArea()","        .overlay(alignment: .topLeading) {","            Button {","                withAnimation(.easeInOut) {","                    showPlan = false","                    store.map.fitBounds(bounds: nil, options: nil)","                }","            } label: {","                Image(systemName: \"arrow.down.right.and.arrow.up.left\")","                    .padding()","                    .background(.thinMaterial, in: Circle())","            }","            .padding()","        }","}"],"syntax":"swift"},{"type":"heading","text":"SDK APIs Used","anchor":"SDK-APIs-Used","level":2},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"API","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan\/createPlanPresenter(with:additionalParams:locationProvider:messageListener:isDebugModeEnabled:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Create a presenter bound to an expo key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Publisher that emits plan loading status changes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/setElementsVisibility(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Hide\/show default SDK UI controls","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/exhibitorsList()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fetch the list of exhibitors for the plan","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/getView()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Get the SwiftUI view for the presenter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/selectExhibitor(nameOrExternalId:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Highlight a booth by name or external ID","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/selectRoute(from:to:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Draw a wayfinding path between two booths","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/fitBounds(bounds:options:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reset the map zoom to show all content","type":"text"}],"type":"paragraph"}]]]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.expofp.sdk\/documentation\/ExpoFP"]]},"identifier":{"url":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Mini-map","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/expofp\/mini-map"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://github.com/expofp/expofp-sdk-ios-examples":{"title":"iOS examples repository","identifier":"https:\/\/github.com\/expofp\/expofp-sdk-ios-examples","type":"link","titleInlineContent":[{"type":"text","text":"iOS examples repository"}],"url":"https:\/\/github.com\/expofp\/expofp-sdk-ios-examples"},"doc://com.expofp.sdk/documentation/ExpoFP/IExpoFpPlanPresenter/exhibitorsList()":{"abstract":[{"type":"text","text":"Request plan exhibitors."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"exhibitorsList"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6ExpoFP0A8FpResulta","text":"ExpoFpResult"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","preciseIdentifier":"s:6ExpoFP0A11FpExhibitorV","text":"ExpoFpExhibitor"},{"kind":"text","text":"]>"}],"role":"sy