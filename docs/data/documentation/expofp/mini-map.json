{"kind":"article","abstract":[{"text":"Embed a floor plan preview in your content screens and expand it into a full interactive map on tap.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"ExpoFP"}],"roleHeading":"Article","title":"Mini-Map"},"sections":[],"identifier":{"url":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/Mini-map","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.expofp.sdk\/documentation\/ExpoFP"]]},"variants":[{"paths":["\/documentation\/expofp\/mini-map"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A mini-map is a floor plan preview embedded directly in your app — right where attendees are already looking. Tap an exhibitor and see exactly where their booth is. Tap again to expand into a full interactive map with wayfinding directions."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/www.youtube.com\/watch?v=4lCnvIRL22I"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example follows a three-screen flow:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Exhibitors List"}],"type":"strong"},{"text":" — loads exhibitors from the SDK and renders them as a scrollable list.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Exhibitor Detail"}],"type":"strong"},{"text":" — shows an inline floor plan preview with the selected booth highlighted, plus Expand and Directions buttons.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fullscreen Plan"}],"type":"strong"},{"text":" — the mini-map expands into a full interactive plan with Collapse and Directions controls.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"image","identifier":"mini-map-wireframe.svg"}],"type":"paragraph"},{"anchor":"Quick-Start","text":"Quick Start","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The full source is in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/expofp\/expofp-sdk-ios-examples"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"code":["git clone https:\/\/github.com\/expofp\/expofp-sdk-ios-examples.git","cd expofp-sdk-ios-examples\/MiniMap","open MiniMap.xcodeproj"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Build and run on a simulator or device (Xcode 16+, iOS 17+)."}],"type":"paragraph"},{"anchor":"Architecture","text":"Architecture","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The pattern uses "},{"inlineContent":[{"text":"two independent","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan"},{"type":"text","text":" presenter instances created once and kept alive for the lifetime of the screen:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"miniMap","type":"codeVoice"},{"text":" — powers the inline thumbnail. Touch input is disabled so it acts as a static preview.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"map","type":"codeVoice"},{"text":" — powers the fullscreen interactive view.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both load the same expo key but operate entirely independently. SwiftUI’s "},{"type":"codeVoice","code":"matchedGeometryEffect"},{"type":"text","text":" animates the frame from the inline position to fullscreen."}],"type":"paragraph"},{"code":["@MainActor","final class ContentStore: ObservableObject {","    let miniMap = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","    let map = ExpoFpPlan.createPlanPresenter(with: .expoKey(\"demo\"))","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Plan-ready-%E2%86%92-load-exhibitors","text":"Plan ready → load exhibitors","level":2,"type":"heading"},{"inlineContent":[{"text":"Observe ","type":"text"},{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","isActive":true,"type":"reference"},{"type":"text","text":" on the mini-map presenter. When it first reaches "},{"code":".ready","type":"codeVoice"},{"text":", strip the default SDK controls from both presenters and fetch the exhibitor list.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".onReceive(store.miniMap.planStatusPublisher) { status in","    self.status = status","","    if status == .ready && exhibitors.isEmpty {","        let visibility = ExpoFpElementsVisibility(","            controls: false,","            levels: false,","            header: false,","            overlay: false","        )","        store.miniMap.setElementsVisibility(visibility)","        store.map.setElementsVisibility(visibility)","","        Task {","            exhibitors = try await store.miniMap.exhibitorsList().get()","        }","    }","}"]},{"anchor":"Embed-the-mini-map-and-handle-interactions","text":"Embed the mini-map and handle interactions","level":2,"type":"heading"},{"inlineContent":[{"text":"Place the mini-map view inline, disable hit-testing, and attach ","type":"text"},{"type":"codeVoice","code":"matchedGeometryEffect"},{"type":"text","text":". When the detail view appears, highlight the booth on both presenters so the correct booth is highlighted whether you are looking at the thumbnail or the fullscreen map."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.miniMap.getView()","    .frame(height: 200)","    .allowsHitTesting(false)","    .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: !showPlan)","    .onAppear {","        store.miniMap.selectExhibitor(nameOrExternalId: exhibitor.externalId)","        store.map.selectExhibitor(nameOrExternalId: exhibitor.externalId)","    }"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"Expand"}]},{"type":"text","text":" button animates to fullscreen; the "},{"type":"strong","inlineContent":[{"type":"text","text":"Directions"}]},{"type":"text","text":" button both expands and draws a wayfinding route:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Expand","Button {","    withAnimation(.easeInOut) { showPlan = true }","} label: {","    Image(systemName: \"arrow.up.left.and.arrow.down.right\")","}","","\/\/ Directions","Button {","    withAnimation(.easeInOut) {","        showPlan = true","        store.map.selectRoute(from: .booth(\"Entrance\"), to: .booth(exhibitor.externalId))","    }","} label: {","    HStack(spacing: 4) {","        Image(.directions)","        Text(\"Directions\").foregroundStyle(.black)","    }","}"]},{"text":"Show the fullscreen plan","type":"heading","level":2,"anchor":"Show-the-fullscreen-plan"},{"inlineContent":[{"type":"text","text":"Overlay the fullscreen presenter view and mirror the "},{"type":"codeVoice","code":"matchedGeometryEffect"},{"type":"text","text":" identifier so SwiftUI connects the two frames. The Collapse button calls "},{"type":"reference","identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/fitBounds(bounds:options:)","isActive":true},{"type":"text","text":" to reset the zoom before animating back."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if showPlan {","    store.map.getView()","        .matchedGeometryEffect(id: exhibitor.id, in: namespace, isSource: showPlan)","        .ignoresSafeArea()","        .overlay(alignment: .topLeading) {","            Button {","                withAnimation(.easeInOut) {","                    showPlan = false","                    store.map.fitBounds(bounds: nil, options: nil)","                }","            } label: {","                Image(systemName: \"arrow.down.right.and.arrow.up.left\")","                    .padding()","                    .background(.thinMaterial, in: Circle())","            }","            .padding()","        }","}"]},{"text":"SDK APIs Used","type":"heading","level":2,"anchor":"SDK-APIs-Used"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/ExpoFpPlan\/createPlanPresenter(with:additionalParams:locationProvider:messageListener:isDebugModeEnabled:)","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a presenter bound to an expo key"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/planStatusPublisher","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Publisher that emits plan loading status changes"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/setElementsVisibility(_:)","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide\/show default SDK UI controls"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPresenter\/exhibitorsList()","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch the list of exhibitors for the plan"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.expofp.sdk\/documentation\/ExpoFP\/IExpoFpPlanPre